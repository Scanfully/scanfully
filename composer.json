{
  "name": "scanfully/scanfully-plugin",
  "description": "Scanfully WordPress plugin: performance and health monitoring.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=7.4",
    "woocommerce/action-scheduler": "^3.9"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/woocommerce-stubs": "^9.0",
    "php-stubs/wordpress-stubs": "^6.9",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/wp-test-utils": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "Scanfully\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Scanfully\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "7.4.0"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "lint:strict": "phpcs --warning-severity=1",
    "stan": "phpstan analyse --memory-limit=2G",
    "stan:baseline": "phpstan analyse --memory-limit=2G --generate-baseline=phpstan-baseline.neon",
    "test": "phpunit --testsuite Unit",
    "test:integration": "phpunit -c phpunit-integration.xml.dist",
    "test:all": "phpunit",
    "test:coverage": "phpunit --testsuite Unit --coverage-html coverage/",
    "qa": [
      "@lint",
      "@stan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "lint": "Run PHPCS (errors only).",
    "lint:fix": "Auto-fix PHPCS violations with PHPCBF.",
    "lint:strict": "Run PHPCS including warnings.",
    "stan": "Run PHPStan static analysis.",
    "stan:baseline": "Regenerate the PHPStan baseline.",
    "test": "Run the PHPUnit unit suite (no WordPress runtime).",
    "test:integration": "Run the PHPUnit integration suite (inside wp-env).",
    "test:all": "Run every PHPUnit suite.",
    "test:coverage": "Run the unit suite with an HTML coverage report.",
    "qa": "Run lint, stan and the unit tests."
  }
}
