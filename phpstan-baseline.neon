# Scanfully PHPStan baseline.
#
# Entries here mask errors that cannot be fixed (typically genuine WP stub gaps
# or WP runtime quirks). Adding an entry REQUIRES a paired comment block:
#
#   # BASELINE: <one-sentence description of the WP-stub gap or WP runtime quirk>
#   # Upstream: <link to upstream issue if one exists, otherwise omit this line>
#   -
#       message: '#...#'
#       count: 1
#       path: src/...
#
# Keep this file empty whenever possible.

parameters:
    ignoreErrors:
        # BASELINE: WC_Data_Store forwards method calls to the loaded data store via __call(), which the WooCommerce stubs do not declare.
        -
            message: '#^Call to an undefined method WC_Data_Store\:\:search_products\(\)\.$#'
            identifier: method.notFound
            count: 1
            path: src/WooCheckout/Controller.php

        # BASELINE: Defensive fallback to WC()->version for when WC_VERSION is not defined; the WooCommerce stubs type the property as a non-null string.
        -
            message: '#^Property WooCommerce\:\:\$version \(string\) on left side of \?\? is not nullable\.$#'
            identifier: nullCoalesce.property
            count: 1
            path: src/WooCheckout/Controller.php

        # BASELINE: Defensive fallback to WC()->version for when WC_VERSION is not defined; the WooCommerce stubs type the property as a non-null string.
        -
            message: '#^Property WooCommerce\:\:\$version \(string\) in isset\(\) is not nullable\.$#'
            identifier: isset.property
            count: 1
            path: src/WooCheckout/Controller.php
